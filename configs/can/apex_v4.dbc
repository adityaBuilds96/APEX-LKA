VERSION "APEX_LKA_v4.0"

NS_ :
    NS_DESC_
    CM_
    BA_DEF_
    BA_
    VAL_
    CAT_DEF_
    CAT_
    FILTER
    BA_DEF_DEF_
    EV_DATA_
    ENVVAR_DATA_
    SGTYPE_
    SGTYPE_VAL_
    BA_DEF_SGTYPE_
    BA_DEF_SGTYPE_VAL_
    BA_DEF_REL_
    BA_DEF_DEF_REL_
    BA_REL_
    BA_SGTYPE_REL_
    BU_SG_REL_
    BU_EV_REL_
    BU_BO_REL_
    SG_MUL_VAL_

BS_ : 500000

BU_ : JETSON_ORIN ARDUINO_PRIMARY ARDUINO_SECONDARY RADAR_STARKENN INS_MTI680

BO_ 80 Heartbeat: 8 JETSON_ORIN
 SG_ NodeID : 0|8@1+ (1,0) [0|255] "" ARDUINO_PRIMARY,ARDUINO_SECONDARY,RADAR_STARKENN,INS_MTI680
 SG_ SystemState : 8|8@1+ (1,0) [0|255] "" ARDUINO_PRIMARY,ARDUINO_SECONDARY,RADAR_STARKENN,INS_MTI680
 SG_ ErrorFlags : 16|16@1+ (1,0) [0|65535] "" ARDUINO_PRIMARY,ARDUINO_SECONDARY,RADAR_STARKENN,INS_MTI680
 SG_ WatchdogCounter : 32|8@1+ (1,0) [0|255] "" ARDUINO_PRIMARY,ARDUINO_SECONDARY
 SG_ Reserved0 : 40|8@1+ (1,0) [0|255] "" Vector__XXX
 SG_ CRC8 : 48|8@1+ (1,0) [0|255] "" ARDUINO_PRIMARY,ARDUINO_SECONDARY
 SG_ Counter : 56|4@1+ (1,0) [0|15] "" ARDUINO_PRIMARY,ARDUINO_SECONDARY

BO_ 256 Steering_Primary: 8 JETSON_ORIN
 SG_ TargetSteeringAngle : 0|16@1+ (0.001,-28.0) [-28.0|28.0] "deg" ARDUINO_PRIMARY,ARDUINO_SECONDARY
 SG_ AngularVelocityLimit : 16|12@1+ (0.1,0.0) [0.0|200.0] "deg/s" ARDUINO_PRIMARY
 SG_ TorqueCommand : 28|12@1+ (0.01,-10.0) [-10.0|10.0] "Nm" ARDUINO_PRIMARY
 SG_ SteeringMode : 40|4@1+ (1,0) [0|15] "" ARDUINO_PRIMARY
 SG_ Reserved1 : 44|4@1+ (1,0) [0|15] "" Vector__XXX
 SG_ CRC8 : 48|8@1+ (1,0) [0|255] "" ARDUINO_PRIMARY
 SG_ Counter : 56|4@1+ (1,0) [0|15] "" ARDUINO_PRIMARY
 SG_ Reserved2 : 60|4@1+ (1,0) [0|15] "" Vector__XXX

BO_ 336 Priority_Risk: 8 JETSON_ORIN
 SG_ DynamicRiskLevel : 0|8@1+ (1,0) [0|255] "" ARDUINO_PRIMARY,ARDUINO_SECONDARY
 SG_ TTC : 8|16@1+ (0.001,0.0) [0.0|10.0] "s" ARDUINO_PRIMARY
 SG_ EmergencyBrakeFlag : 24|1@1+ (1,0) [0|1] "" ARDUINO_PRIMARY,ARDUINO_SECONDARY
 SG_ RiskZoneID : 25|4@1+ (1,0) [0|15] "" ARDUINO_PRIMARY
 SG_ Reserved3 : 29|3@1+ (1,0) [0|7] "" Vector__XXX
 SG_ RiskConfidence : 32|8@1+ (0.392,0.0) [0.0|100.0] "%" ARDUINO_PRIMARY
 SG_ CRC8 : 48|8@1+ (1,0) [0|255] "" ARDUINO_PRIMARY
 SG_ Counter : 56|4@1+ (1,0) [0|15] "" ARDUINO_PRIMARY
 SG_ Reserved4 : 60|4@1+ (1,0) [0|15] "" Vector__XXX

BO_ 352 Spatial_State: 8 JETSON_ORIN
 SG_ HeadingError : 0|16@1+ (0.01,-180.0) [-180.0|180.0] "deg" ARDUINO_PRIMARY
 SG_ LateralError : 16|16@1+ (0.001,-16.0) [-16.0|16.0] "m" ARDUINO_PRIMARY
 SG_ PathCurvature : 32|12@1+ (0.0001,-0.2) [-0.2|0.2] "1/m" ARDUINO_PRIMARY
 SG_ Reserved5 : 44|4@1+ (1,0) [0|15] "" Vector__XXX
 SG_ CRC8 : 48|8@1+ (1,0) [0|255] "" ARDUINO_PRIMARY
 SG_ Counter : 56|4@1+ (1,0) [0|15] "" ARDUINO_PRIMARY
 SG_ Reserved6 : 60|4@1+ (1,0) [0|15] "" Vector__XXX

BO_ 368 Trajectory_Poly: 8 JETSON_ORIN
 SG_ PolyCoeffA : 0|10@1+ (0.001,-0.5) [-0.5|0.5] "" ARDUINO_PRIMARY
 SG_ PolyCoeffB : 10|10@1+ (0.001,-0.5) [-0.5|0.5] "" ARDUINO_PRIMARY
 SG_ PolyCoeffC : 20|10@1+ (0.001,-0.5) [-0.5|0.5] "" ARDUINO_PRIMARY
 SG_ PolyCoeffD : 30|10@1+ (0.01,-5.0) [-5.0|5.0] "m" ARDUINO_PRIMARY
 SG_ Reserved7 : 40|8@1+ (1,0) [0|255] "" Vector__XXX
 SG_ CRC8 : 48|8@1+ (1,0) [0|255] "" ARDUINO_PRIMARY
 SG_ Counter : 56|4@1+ (1,0) [0|15] "" ARDUINO_PRIMARY
 SG_ Reserved8 : 60|4@1+ (1,0) [0|15] "" Vector__XXX

BO_ 384 Vehicle_Kinematics: 8 JETSON_ORIN
