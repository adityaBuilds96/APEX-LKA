CM_ BU_ JETSON_ORIN "NVIDIA Jetson Orin NX — Primary compute node running APEX-LKA autonomy stack at 500 kbps.";
CM_ BU_ ARDUINO_PRIMARY "Arduino Mega 2560 #1 — Primary SPI MCP2515 CAN bridge. Handles steering actuation and safety relay.";
CM_ BU_ ARDUINO_SECONDARY "Arduino Mega 2560 #2 — Redundant CAN bridge node. Secondary safety interlock and fallback.";
CM_ BU_ RADAR_STARKENN "Starkenn Orion 77GHz FMCW Radar — Forward obstacle detection sensor. 8 simultaneous target tracks.";
CM_ BU_ INS_MTI680 "Xsens MTi-680 GNSS/INS — Dual-antenna RTK GPS + IMU inertial navigation system at 100 Hz.";

CM_ BO_ 80 "Heartbeat: 100 Hz by JETSON_ORIN. All nodes must receive this within 15ms to remain active.";
CM_ BO_ 256 "Steering primary command: 30 Hz. TargetSteeringAngle range +-28.0 degrees. Safety-critical frame.";
CM_ BO_ 336 "Priority risk: 30 Hz. TTC range 0-10.0 seconds. EmergencyBrakeFlag triggers relay interlock.";
CM_ BO_ 352 "Spatial state: 30 Hz. HeadingError, LateralError, PathCurvature from planning module.";
CM_ BO_ 368 "Trajectory polynomial: 30 Hz. Cubic path coefficients A,B,C,D for lateral prediction.";
CM_ BO_ 384 "Vehicle kinematics: 100 Hz. WheelSpeed, YawRate, LongitudinalAccel, LateralAccel.";
CM_ BO_ 400 "Plan/control status: 30 Hz. ControllerMode, HealthBitmask, failsafe level, loop latency.";
CM_ BO_ 800 "MTi-680 Euler orientation: 100 Hz. Roll, Pitch, Yaw at 0.01 deg resolution from INS_MTI680.";
CM_ BO_ 801 "MTi-680 velocity: 100 Hz. East, North, Down velocity. GnssFixType indicates RTK quality.";
CM_ BO_ 1024 "Starkenn radar header: 20 Hz. TargetCount, BusLoad, StatusFlags, RadarMode, SensorTemp, FrameID.";
CM_ BO_ 1025 "Starkenn radar track 1 of 8: 20 Hz. RangeX/Y 0.05m, RelVelX/Y 0.01 m/s, RCS, Confidence.";
CM_ BO_ 1026 "Starkenn radar track 2 of 8. Same structure as Track1.";
CM_ BO_ 1027 "Starkenn radar track 3 of 8. Same structure as Track1.";
CM_ BO_ 1028 "Starkenn radar track 4 of 8. Same structure as Track1.";
CM_ BO_ 1029 "Starkenn radar track 5 of 8. Same structure as Track1.";
CM_ BO_ 1030 "Starkenn radar track 6 of 8. Same structure as Track1.";
CM_ BO_ 1031 "Starkenn radar track 7 of 8. Same structure as Track1.";
CM_ BO_ 1032 "Starkenn radar track 8 of 8. Same structure as Track1.";

CM_ SG_ 80 NodeID "Node identifier. 0x01=Jetson, 0x02=Arduino_Primary, 0x03=Arduino_Secondary.";
CM_ SG_ 80 SystemState "System state. 0=INIT, 1=STANDBY, 2=ACTIVE, 3=DEGRADED, 4=FAILSAFE, 5=SHUTDOWN.";
CM_ SG_ 80 ErrorFlags "16-bit error bitmask. Bit0=CAN_ERR, Bit1=IMU_ERR, Bit2=RADAR_ERR, Bit3=STEERING_ERR.";
CM_ SG_ 80 WatchdogCounter "Rolling watchdog counter. Arduino resets relay if stalls > 200ms.";
CM_ SG_ 80 CRC8 "SAE J1850 CRC-8 polynomial 0x1D checksum over bytes 0-5.";
CM_ SG_ 80 Counter "4-bit rolling frame counter 0-15 for sequence validation.";
CM_ SG_ 256 TargetSteeringAngle "Target steering angle. Range -28.0 to +28.0 deg. Scale 0.001 deg/LSB.";
CM_ SG_ 256 AngularVelocityLimit "Max angular velocity 0-200.0 deg/s. Scale 0.1 deg/s/LSB.";
CM_ SG_ 256 TorqueCommand "Direct torque -10.0 to +10.0 Nm. Scale 0.01 Nm/LSB.";
CM_ SG_ 256 SteeringMode "0=DISABLE, 1=ANGLE_CTRL, 2=TORQUE_CTRL, 3=EMERGENCY, 4=MANUAL.";
CM_ SG_ 336 DynamicRiskLevel "Risk 0-255. 0=CLEAR, 85=LOW, 170=MEDIUM, 220=HIGH, 255=CRITICAL_STOP.";
CM_ SG_ 336 TTC "Time-to-collision 0.0-10.0 s. Scale 0.001 s/LSB. 65535=no target.";
CM_ SG_ 336 EmergencyBrakeFlag "1 = engage full braking and relay interlock.";
CM_ SG_ 336 RiskConfidence "Risk confidence 0-100%. Scale 0.392%/LSB.";
CM_ SG_ 352 HeadingError "Heading error -180.0 to +180.0 deg. Scale 0.01 deg/LSB.";
CM_ SG_ 352 LateralError "Lateral deviation -16.0 to +16.0 m. Scale 0.001 m/LSB.";
CM_ SG_ 352 PathCurvature "Path curvature -0.2 to +0.2 1/m. Scale 0.0001 1/m/LSB.";
CM_ SG_ 368 PolyCoeffA "Cubic trajectory polynomial A (cubic term). Range -0.5 to +0.5.";
CM_ SG_ 368 PolyCoeffB "Cubic trajectory polynomial B (quadratic term). Range -0.5 to +0.5.";
CM_ SG_ 368 PolyCoeffC "Cubic trajectory polynomial C (linear term). Range -0.5 to +0.5.";
CM_ SG_ 368 PolyCoeffD "Cubic trajectory polynomial D (offset). Range -5.0 to +5.0 m.";
CM_ SG_ 384 WheelSpeed "Wheel speed 0-250 km/h. Scale 0.01 km/h/LSB.";
CM_ SG_ 384 YawRate "Yaw rate -20.48 to +20.47 deg/s. Scale 0.01 deg/s/LSB.";
CM_ SG_ 384 LongitudinalAccel "Longitudinal accel -5.12 to +5.11 m/s2. Scale 0.01 m/s2/LSB.";
CM_ SG_ 384 LateralAccel "Lateral accel -5.12 to +5.11 m/s2. Scale 0.01 m/s2/LSB.";
CM_ SG_ 400 ControllerMode "0=OFF, 1=STANDBY, 2=ACTIVE, 3=OVERRIDE, 4=FAILSAFE.";
CM_ SG_ 400 HealthBitmask "20-bit subsystem health. 0=OK, 1=FAULT per module bit.";
CM_ SG_ 400 FailsafeLevel "0=NOMINAL, 1=WARN, 2=DEGRADE, 3=FAILSAFE, 4=SHUTDOWN.";
CM_ SG_ 400 LoopLatencyUs "Main loop latency us. Target < 1500. Alert > 5000.";
CM_ SG_ 800 Roll "Roll angle -180 to +180 deg. Scale 0.01 deg/LSB.";
CM_ SG_ 800 Pitch "Pitch angle -90 to +90 deg. Scale 0.01 deg/LSB.";
CM_ SG_ 800 Yaw "True-North heading 0-360 deg. Scale 0.1 deg/LSB.";
CM_ SG_ 800 InsStatus "0=INIT, 1=COARSE, 2=FINE, 3=RTK_FLOAT, 4=RTK_FIXED, 5=DEAD_RECK.";
CM_ SG_ 801 VelocityEast "ECEF East velocity -327.68 to +327.67 m/s. Scale 0.01 m/s/LSB.";
CM_ SG_ 801 VelocityNorth "ECEF North velocity -327.68 to +327.67 m/s. Scale 0.01 m/s/LSB.";
CM_ SG_ 801 VelocityDown "ECEF Down velocity -20.48 to +20.47 m/s. Scale 0.01 m/s/LSB.";
CM_ SG_ 801 GnssFixType "0=NO_FIX, 1=SINGLE, 2=SBAS, 3=DGPS, 4=RTK_FLOAT, 5=RTK_FIXED, 6=PPP.";
CM_ SG_ 1024 TargetCount "Number of valid radar tracks in this scan. Range 0-8.";
CM_ SG_ 1024 BusLoad "Estimated CAN bus load 0-100%.";
CM_ SG_ 1024 StatusFlags "Bit0=SENSOR_OK, Bit1=TEMP_OK, Bit2=BLOCKER_FREE, Bit3=ALIGN_OK.";
CM_ SG_ 1024 RadarMode "0=STANDBY, 1=NEAR, 2=FAR, 3=COMBINED, 4=CALIBRATION.";
CM_ SG_ 1024 SensorTemp "Radar board temperature -40 to +90 degC.";
CM_ SG_ 1025 TrackID "Track object ID 0-15. Persistent across frames until track lost.";
CM_ SG_ 1025 RangeX "Longitudinal range -50.0 to +154.75 m. Scale 0.05 m/LSB.";
CM_ SG_ 1025 RangeY "Lateral range -25.0 to +179.75 m. Scale 0.05 m/LSB.";
CM_ SG_ 1025 RelVelX "Relative longitudinal velocity -25.6 to +25.58 m/s. Scale 0.01 m/s/LSB.";
CM_ SG_ 1025 RelVelY "Relative lateral velocity -6.4 to +6.42 m/s. Scale 0.01 m/s/LSB.";
CM_ SG_ 1025 RCS_Flag "RCS above -15 dBm flag. 0=below, 1=above threshold.";
CM_ SG_ 1025 ConfFlag "Track confidence above 60% flag. 0=low, 1=high confidence.";

