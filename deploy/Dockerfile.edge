# ==============================================================================
# APEX LKA • Production Edge Multi-Stage Dockerfile
# Optimized for NVIDIA Jetson Orin (L4T r35.3.1) & Workstation (CUDA 12.2)
# Hard Constraint: Final Image Size <= 3.5 GB
# ==============================================================================

# Stage 1: Build & Python Wheel Preparation
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-dev \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY requirements.txt .
# Install into wheels directory
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel && \
    pip3 wheel --no-cache-dir --wheel-dir=/build/wheels \
        opencv-python-headless>=4.8.0 \
        numpy>=1.24.0 \
        pyyaml>=6.0 \
        python-can>=4.3.0 \
        pyserial>=3.5 \
        scipy>=1.11.0 \
        onnxruntime>=1.16.0

# ==============================================================================
# Stage 2: Minimal Production Runtime
# ==============================================================================
FROM ubuntu:22.04 AS runtime

LABEL maintainer="APEX LKA Autonomous Platform Team <aditya@apexlka.internal>" \
      version="1.0.0" \
      description="Production Edge Autonomous Vehicle Stack"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    APEX_PROFILE="baja_2027" \
    APEX_HAL_BACKEND="auto" \
    APEX_NET_PROTOCOL="can"

# Install minimal OS runtime packages (SocketCAN, V4L2 utilities, net-tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    can-utils \
    iproute2 \
    v4l-utils \
    libglib2.0-0 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install pre-built wheels from builder stage
COPY --from=builder /build/wheels /tmp/wheels
RUN pip3 install --no-cache-dir --no-index --find-links=/tmp/wheels /tmp/wheels/*.whl && \
    rm -rf /tmp/wheels

# Create dedicated non-root autonomous system user with dialout/video groups
RUN useradd -m -s /bin/bash -u 1000 apex && \
    usermod -aG dialout,video apex

WORKDIR /app

# Copy application codebase
COPY --chown=apex:apex src/ /app/src/
COPY --chown=apex:apex deploy/ /app/deploy/
COPY --chown=apex:apex configs/ /app/configs/
COPY --chown=apex:apex vehicle_profiles/ /app/vehicle_profiles/
COPY --chown=apex:apex models/ /app/models/
COPY --chown=apex:apex run.py /app/run.py

# Ensure executable permissions on entrypoint script
RUN chmod +x /app/deploy/docker_entrypoint.sh

# Edge healthcheck testing process liveness and HAL telemetry
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=3 \
    CMD python3 -c "from src.hardware.hal import get_hal; h = get_hal(); assert h.active_backend.is_available()" || exit 1

USER apex

ENTRYPOINT ["/app/deploy/docker_entrypoint.sh"]
CMD ["python3", "deploy/jetson_run.py", "--sim"]
