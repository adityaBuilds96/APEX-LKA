[Unit]
Description=APEX LKA Autonomous Vehicle Perception Engine
After=multi-user.target network.target

[Service]
Type=simple
User=jetson
WorkingDirectory=/home/jetson/APEX-LKA
ExecStartPre=/sbin/ip link set can0 up type can bitrate 500000
ExecStart=/usr/bin/python3 deploy/jetson_run.py --config deploy/deploy_config.yaml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
